---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url }}</loc></url>
  <url><loc>{{ '/essays/' | absolute_url }}</loc></url>
  <url><loc>{{ '/directory/' | absolute_url }}</loc></url>
  {%- assign essays = site.essays | sort: "date" | reverse %}
  {%- for e in essays %}
  <url><loc>{{ e.url | absolute_url }}</loc><lastmod>{{ e.updated | default: e.date | date: "%Y-%m-%d" }}</lastmod></url>
  {%- if e.pdf %}
  <url><loc>{{ e.pdf | absolute_url }}</loc><lastmod>{{ e.updated | default: e.date | date: "%Y-%m-%d" }}</lastmod></url>
  {%- endif %}
  {%- endfor %}
</urlset>
